# Maintainer: KryptonOS Core Team <dev@kryptonos.org>
pkgname=krypton-settings
pkgver=1.0.0
pkgrel=1
pkgdesc="KryptonOS default desktop settings, Hyprland presets, Waybar themes, and Kitty configs"
arch=('any')
license=('GPL3')
depends=('hyprland' 'waybar' 'kitty' 'starship' 'zsh' 'yazi' 'swaync')

package() {
    install -d "${pkgdir}/usr/share/krypton/skel/.config"

    # Install user desktop presets into /usr/share/krypton/skel
    cp -r "${startdir}/../../airootfs/etc/skel/.config/"* "${pkgdir}/usr/share/krypton/skel/.config/"
    install -Dm644 "${startdir}/../../airootfs/etc/skel/.zshrc" "${pkgdir}/usr/share/krypton/skel/.zshrc"

    # Install global environment flags for Wayland
    install -d "${pkgdir}/etc/environment.d"
    cat << 'EOF' > "${pkgdir}/etc/environment.d/10-krypton-wayland.conf"
MOZ_ENABLE_WAYLAND=1
QT_QPA_PLATFORM=wayland;xcb
GDK_BACKEND=wayland,x11,*
SDL_VIDEODRIVER=wayland
CLUTTER_BACKEND=wayland
XDG_CURRENT_DESKTOP=Hyprland
XDG_SESSION_TYPE=wayland
XDG_SESSION_DESKTOP=Hyprland
EOF
}
