# Maintainer: KryptonOS Core Team <dev@kryptonos.org>
pkgname=krypton-branding
pkgver=1.0.0
pkgrel=1
pkgdesc="KryptonOS core distro branding, release information, and system identification"
arch=('any')
license=('GPL3')
provides=('os-release' 'system-release')

package() {
    install -d "${pkgdir}/etc"
    install -d "${pkgdir}/usr/share/libalpm/hooks"

    # Store KryptonOS os-release template
    cat << 'EOF' > "${pkgdir}/etc/krypton-release"
NAME="KryptonOS"
PRETTY_NAME="KryptonOS Linux"
ID=kryptonos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;166;227;161"
HOME_URL="https://github.com/TheoGabrielEid/Project-Kryptonos"
LOGO=archlinux-logo
EOF

    # ALPM Hook to apply KryptonOS branding over /etc/os-release after filesystem installs
    cat << 'EOF' > "${pkgdir}/usr/share/libalpm/hooks/99-krypton-branding.hook"
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem
Target = krypton-branding

[Action]
Description = [KryptonOS] Applying OS branding and release identity...
When = PostTransaction
Exec = /usr/bin/cp -f /etc/krypton-release /usr/lib/os-release
EOF

    # Hostname default
    echo "kryptonos" > "${pkgdir}/etc/hostname"
}
