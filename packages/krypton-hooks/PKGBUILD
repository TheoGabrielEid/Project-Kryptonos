# Maintainer: KryptonOS Core Team <dev@kryptonos.org>
pkgname=krypton-hooks
pkgver=1.0.0
pkgrel=1
pkgdesc="KryptonOS Pacman hooks for automatic system optimization and config synchronization"
arch=('any')
license=('GPL3')
depends=('pacman')

package() {
    install -d "${pkgdir}/usr/share/libalpm/hooks"

    # Hook: Auto-update font cache on package installs
    cat << 'EOF' > "${pkgdir}/usr/share/libalpm/hooks/90-krypton-fontconfig.hook"
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/share/fonts/*

[Action]
Description = [KryptonOS] Updating system font cache...
When = PostTransaction
Exec = /usr/bin/fc-cache -s
EOF

    # Hook: Recompile GTK & Icon caches
    cat << 'EOF' > "${pkgdir}/usr/share/libalpm/hooks/95-krypton-icon-cache.hook"
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/share/icons/*

[Action]
Description = [KryptonOS] Updating icon theme caches...
When = PostTransaction
Exec = /usr/bin/gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
EOF
}
