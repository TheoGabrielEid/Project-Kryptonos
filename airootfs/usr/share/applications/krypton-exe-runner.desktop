[Desktop Entry]
Type=Application
Name=Wine Windows Program Loader
GenericName=Windows Program Loader
Comment=Run Windows applications (.exe, .msi) on KryptonOS
Exec=/usr/local/bin/krypton-exe-runner %f
MimeType=application/x-msdos-program;application/x-msdownload;application/x-msi;application/x-wine-extension-msp;application/x-dosexec;
Icon=wine
NoDisplay=false
StartupNotify=true
Categories=System;Utility;
Keywords=wine;windows;exe;msi;run;games;compatibility;
