#!/usr/bin/env bash
# ==============================================================================
# KryptonOS Desktop Wallpaper Controller & Daemon Launcher
# Usage: krypton-wallpaper [path_to_image]
# ==============================================================================
TARGET="$1"

if [ -z "$TARGET" ]; then
    if [ -f "$HOME/.config/hypr/.current_wallpaper" ]; then
        TARGET=$(cat "$HOME/.config/hypr/.current_wallpaper" | tr -d '\r\n')
    fi
fi

if [ -z "$TARGET" ] || [ ! -f "$TARGET" ]; then
    if [ -f "/usr/share/backgrounds/krypton/anime/lofi-study.png" ]; then
        TARGET="/usr/share/backgrounds/krypton/anime/lofi-study.png"
    elif [ -f "/usr/share/backgrounds/krypton/krypton-default.png" ]; then
        TARGET="/usr/share/backgrounds/krypton/krypton-default.png"
    elif [ -f "/usr/share/backgrounds/krypton/wallpaper.png" ]; then
        TARGET="/usr/share/backgrounds/krypton/wallpaper.png"
    fi
fi

mkdir -p "$HOME/.config/hypr"
echo "$TARGET" > "$HOME/.config/hypr/.current_wallpaper"

# If daemon is already running, send SIGUSR1 for instant live switch
if pgrep -f "krypton-wallpaper-render" >/dev/null 2>&1; then
    pkill -SIGUSR1 -f "krypton-wallpaper-render" 2>/dev/null || true
else
    # Start daemon
    killall hyprpaper 2>/dev/null || true
    python3 /usr/local/bin/krypton-wallpaper-render "$TARGET" >/tmp/krypton-wall.log 2>&1 &
fi
