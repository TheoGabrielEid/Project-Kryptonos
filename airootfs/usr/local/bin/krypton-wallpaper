#!/usr/bin/env bash
# ==============================================================================
# KryptonOS Desktop Wallpaper Daemon (GtkLayerShell + Fallback)
# Works on ALL GPUs (Mesa svga, vmwgfx, Intel, AMD, NVIDIA)
# ==============================================================================
WALL="${1:-/usr/share/backgrounds/krypton/krypton-default.png}"
if [ ! -f "$WALL" ]; then
    WALL="/usr/share/backgrounds/krypton/wallpaper.png"
fi

mkdir -p "$HOME/.config/hypr"
echo "$WALL" > "$HOME/.config/hypr/.current_wallpaper"

pkill -f "krypton-wallpaper-render" 2>/dev/null || true
killall hyprpaper 2>/dev/null || true

# Try GTK Layer Shell Python renderer first
python3 /usr/local/bin/krypton-wallpaper-render "$WALL" >/tmp/krypton-wall.log 2>&1 &
PID=$!
sleep 0.5
if ! kill -0 $PID 2>/dev/null; then
    # Fallback to hyprpaper
    hyprpaper >/dev/null 2>&1 &
fi
