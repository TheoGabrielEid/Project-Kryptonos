#!/usr/bin/env python3
"""
KryptonOS Intelligent Battery & Power Monitor for Waybar
Detects hardware ACPI battery, VMware host battery passthrough, upower, or AC mains.
Guarantees the battery indicator is always visible and functional on the top menu bar.
"""
import glob
import json
import os
import subprocess
import sys


def get_power_info():
    # 1. Check ACPI Power Supply directory (/sys/class/power_supply/BAT*)
    bat_paths = glob.glob("/sys/class/power_supply/BAT*") + \
                glob.glob("/sys/class/power_supply/battery*") + \
                glob.glob("/sys/class/power_supply/CMB*")

    for b in bat_paths:
        cap_file = os.path.join(b, "capacity")
        stat_file = os.path.join(b, "status")
        if os.path.exists(cap_file):
            try:
                with open(cap_file, "r") as f:
                    capacity = max(0, min(100, int(f.read().strip())))
                status = "Discharging"
                if os.path.exists(stat_file):
                    with open(stat_file, "r") as f:
                        status = f.read().strip()

                is_charging = status.lower() in ("charging", "full")
                
                icons = ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
                icon_idx = min(10, max(0, capacity // 10))
                icon = "󰂄" if is_charging else icons[icon_idx]
                
                if is_charging:
                    cls = "charging"
                elif capacity <= 15:
                    cls = "critical"
                elif capacity <= 30:
                    cls = "warning"
                else:
                    cls = "normal"

                return {
                    "text": f"{icon} {capacity}%",
                    "tooltip": f"Battery: {capacity}% ({status})\nPower Source: Battery ({os.path.basename(b)})",
                    "class": cls,
                    "percentage": capacity,
                    "raw_status": f"Battery {capacity}% ({status})"
                }
            except Exception:
                pass

    # 2. Check upower command
    try:
        devices = subprocess.check_output(
            ["upower", "-e"], stderr=subprocess.DEVNULL, timeout=1.5, text=True
        ).splitlines()
        
        for dev in devices:
            if "battery" in dev.lower() or "display_device" in dev.lower():
                dev_info = subprocess.check_output(
                    ["upower", "-i", dev], stderr=subprocess.DEVNULL, timeout=1.5, text=True
                )
                cap = None
                state = "Discharging"
                for line in dev_info.splitlines():
                    line = line.strip()
                    if line.startswith("percentage:"):
                        cap = int(float(line.split(":")[1].replace("%", "").strip()))
                    elif line.startswith("state:"):
                        state = line.split(":")[1].strip()

                if cap is not None:
                    is_charging = "charg" in state.lower() or "full" in state.lower()
                    icons = ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
                    icon_idx = min(10, max(0, cap // 10))
                    icon = "󰂄" if is_charging else icons[icon_idx]
                    cls = "charging" if is_charging else ("critical" if cap <= 15 else ("warning" if cap <= 30 else "normal"))

                    return {
                        "text": f"{icon} {cap}%",
                        "tooltip": f"Battery: {cap}% ({state})\nDetected via UPower",
                        "class": cls,
                        "percentage": cap,
                        "raw_status": f"Battery {cap}% ({state})"
                    }
    except Exception:
        pass

    # 3. Check AC adapter status (/sys/class/power_supply/AC* /ADP* /line*)
    ac_paths = glob.glob("/sys/class/power_supply/AC*") + \
               glob.glob("/sys/class/power_supply/ADP*") + \
               glob.glob("/sys/class/power_supply/*online*")
    for a in ac_paths:
        online_file = os.path.join(a, "online")
        if os.path.exists(online_file):
            try:
                with open(online_file, "r") as f:
                    online = f.read().strip()
                if online == "1":
                    return {
                        "text": "󰚥 100%",
                        "tooltip": "Power Supply: Connected to AC / Host Power (100%)\nStatus: Optimal Power Delivery",
                        "class": "plugged",
                        "percentage": 100,
                        "raw_status": "AC Power: Connected (100%)"
                    }
            except Exception:
                pass

    # 4. Universal Solid Fallback for VM / Desktop
    return {
        "text": "󰚥 100%",
        "tooltip": "Power Supply: Connected to AC / Host Power (100%)\nStatus: Continuous Power Supply",
        "class": "plugged",
        "percentage": 100,
        "raw_status": "Connected to AC Power"
    }


def main():
    info = get_power_info()
    if len(sys.argv) > 1 and sys.argv[1] == "--info":
        print(info.get("tooltip", info.get("raw_status", "Power OK")))
    else:
        print(json.dumps(info))


if __name__ == "__main__":
    main()
