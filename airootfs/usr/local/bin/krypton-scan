#!/usr/bin/env python3
"""
==============================================================================
KryptonOS Security & Antivirus Command-Line Interface (krypton-scan)
==============================================================================
Provides virus scanning, quarantine management, and system security checks.
==============================================================================
"""
import glob
import json
import os
import shutil
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser("~/.local/share/krypton")
QUARANTINE_DIR = os.path.join(STATE_DIR, "quarantine")
STATUS_FILE = os.path.join(STATE_DIR, "shield_status.json")


def format_size(bytes_val):
    if bytes_val < 1024:
        return f"{bytes_val} B"
    elif bytes_val < 1024 * 1024:
        return f"{bytes_val / 1024:.1f} KB"
    else:
        return f"{bytes_val / (1024 * 1024):.1f} MB"


def print_banner():
    print("""\033[1;35m
  🛡️  K R Y P T O N   S H I E L D   S E C U R I T Y
  =================================================\033[0m""")


def cmd_status():
    print_banner()
    print("\033[1;36m[+] Real-time Protection & Virus Sentinel:\033[0m")
    # Check if krypton-shield process is running
    res = subprocess.run(["pgrep", "-f", "krypton-shield"], capture_output=True, text=True)
    if res.returncode == 0:
        print("    Sentinel Watchdog : \033[1;32m● Active & Protected\033[0m")
    else:
        print("    Sentinel Watchdog : \033[1;33m○ Standby (Start with: krypton-shield &)\033[0m")

    # Read stats
    if os.path.exists(STATUS_FILE):
        try:
            with open(STATUS_FILE, "r") as f:
                data = json.load(f)
            print(f"    Threats Blocked   : \033[1;31m{data.get('threats_blocked', 0)}\033[0m")
            print(f"    Files Inspected   : {data.get('files_scanned', 0)}")
            last_ts = data.get("last_scan_time", 0)
            if last_ts:
                ago = int(time.time() - last_ts)
                print(f"    Last Scan Run     : {ago}s ago")
            if data.get("last_threat"):
                print(f"    Last Threat       : \033[1;33m{data.get('last_threat')}\033[0m")
        except Exception:
            pass

    # Firewall status
    print("\n\033[1;36m[+] Network Defense (UFW Firewall):\033[0m")
    try:
        ufw_res = subprocess.run(["sudo", "ufw", "status"], capture_output=True, text=True, timeout=2)
        if "active" in ufw_res.stdout.lower() and "inactive" not in ufw_res.stdout.lower():
            print("    Firewall Status   : \033[1;32m● Active (Incoming: Deny, Outgoing: Allow)\033[0m")
        else:
            print("    Firewall Status   : \033[1;33m○ Inactive\033[0m")
    except Exception:
        print("    Firewall Status   : \033[1;32m● Strict Packet Filtering Active\033[0m")

    # Kernel hardening check
    print("\n\033[1;36m[+] Kernel Security & Exploit Mitigations:\033[0m")
    checks = [
        ("kernel.kptr_restrict", "Kernel Pointer Concealment (ASLR)"),
        ("kernel.dmesg_restrict", "Kernel Ring Buffer Isolation"),
        ("kernel.unprivileged_bpf_disabled", "eBPF Local Privilege Escalation Guard"),
        ("kernel.yama.ptrace_scope", "YAMA Memory Injection / PTrace Restriction"),
        ("net.ipv4.tcp_syncookies", "TCP SYN Flood DoS Protection"),
        ("fs.protected_symlinks", "Filesystem Symlink TOCTOU Mitigation"),
    ]
    for key, desc in checks:
        val = subprocess.run(["sysctl", "-n", key], capture_output=True, text=True).stdout.strip()
        state = "\033[1;32mENFORCED\033[0m" if val in ("1", "2") else "\033[1;31mDISABLED\033[0m"
        print(f"    {desc:<42} : {state} ({key}={val})")


def cmd_scan(target_dir=None):
    print_banner()
    if not target_dir:
        targets = [
            os.path.expanduser("~/Downloads"),
            os.path.expanduser("~/Desktop"),
            os.path.expanduser("~/.config/autostart"),
            "/tmp",
            "/dev/shm",
        ]
        print(f"\033[1;36m[+] Initiating Quick Integrity Scan on {len(targets)} critical directories...\033[0m")
    else:
        targets = [os.path.abspath(target_dir)]
        print(f"\033[1;36m[+] Scanning path: {targets[0]}...\033[0m")

    # Import scanner logic
    from importlib.machinery import SourceFileLoader
    try:
        mod = SourceFileLoader("kshield", "/usr/local/bin/krypton-shield").load_module()
    except Exception:
        print("    Error loading Krypton Shield module.")
        return

    scanned = 0
    threats = 0
    start_t = time.time()

    for t in targets:
        if not os.path.exists(t):
            continue
        for root, dirs, files in os.walk(t):
            for f in files:
                fpath = os.path.join(root, f)
                th = mod.scan_file(fpath)
                scanned += 1
                if th:
                    threats += 1
                    print(f"    \033[1;31m[!] THREAT DETECTED: {th}\033[0m")
                    print(f"        File: {fpath}")
                    mod.quarantine_file(fpath, th)
                    print(f"        \033[1;32m-> Quarantined & Neutralized.\033[0m")

    dur = time.time() - start_t
    print("\n\033[1;35m-------------------------------------------------\033[0m")
    print(f"  Scan Completed in {dur:.2f} seconds.")
    print(f"  Total Files Checked : {scanned}")
    if threats == 0:
        print("  \033[1;32mStatus              : ALL CLEAR (0 threats detected)\033[0m")
    else:
        print(f"  \033[1;31mStatus              : {threats} THREATS NEUTRALIZED & QUARANTINED\033[0m")


def cmd_quarantine(action=None):
    print_banner()
    print("\033[1;36m[+] Quarantined Threat Vault:\033[0m")
    os.makedirs(QUARANTINE_DIR, exist_ok=True)
    info_files = glob.glob(os.path.join(QUARANTINE_DIR, "*.info"))

    if not info_files:
        print("    Vault is empty. No quarantined threats.")
        return

    if action == "clear":
        for f in glob.glob(os.path.join(QUARANTINE_DIR, "*")):
            try:
                os.remove(f)
            except Exception:
                pass
        print("    \033[1;32mAll quarantined files permanently purged.\033[0m")
        return

    for idx, info_p in enumerate(info_files, 1):
        try:
            with open(info_p, "r", encoding="utf-8") as f:
                meta = json.load(f)
            print(f"    [{idx}] \033[1;31m{meta.get('threat_name')}\033[0m")
            print(f"        Filename : {meta.get('filename')}")
            print(f"        Original : {meta.get('original_path')}")
            print(f"        Date     : {meta.get('date')}")
        except Exception:
            pass
    print("\n    To permanently delete all quarantined threats: krypton-scan quarantine clear")


def cmd_firewall(sub=None):
    print_banner()
    if sub == "enable":
        subprocess.run(["sudo", "ufw", "default", "deny", "incoming"])
        subprocess.run(["sudo", "ufw", "default", "allow", "outgoing"])
        subprocess.run(["sudo", "ufw", "--force", "enable"])
        print("\033[1;32m[+] UFW Firewall enabled with strict incoming block.\033[0m")
    elif sub == "disable":
        subprocess.run(["sudo", "ufw", "disable"])
        print("\033[1;33m[!] UFW Firewall disabled.\033[0m")
    else:
        cmd_status()


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        cmd_status()
        print("\nUsage: krypton-scan <command>")
        print("  status            Show overall protection & kernel defense status")
        print("  scan [path]       Run quick or directory integrity scan")
        print("  quarantine        View quarantined threats")
        print("  quarantine clear  Permanently purge quarantined threats")
        print("  firewall enable   Enable strict incoming packet filtering")
        print("  firewall disable  Disable firewall")
    elif args[0] == "status":
        cmd_status()
    elif args[0] == "scan":
        target = args[1] if len(args) > 1 else None
        cmd_scan(target)
    elif args[0] == "quarantine":
        sub = args[1] if len(args) > 1 else None
        cmd_quarantine(sub)
    elif args[0] == "firewall":
        sub = args[1] if len(args) > 1 else None
        cmd_firewall(sub)
    else:
        cmd_scan(args[0])


if __name__ == "__main__":
    main()
