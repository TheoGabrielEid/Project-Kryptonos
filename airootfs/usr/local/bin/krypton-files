#!/usr/bin/env python3
"""
==============================================================================
KryptonOS Native File Explorer (krypton-files)
==============================================================================
Features:
- Native System Navigation Bar with window controls:
  [ 🗕 Minimize ] [ 🗖 Maximize / Windowed ] [ ✕ Close ]
- Draggable Titlebar when windowed (Windows style) & double-click maximize
- Places Sidebar: Home, Desktop, Documents, Downloads, Pictures, Music, Videos, Coding Projects, Root, Trash
- Icon Grid View & Detailed List View with seamless toggle
- Breadcrumb / Editable Path Bar and Live Real-time Search
- Full File Operations: Open, Open in Terminal (Kitty), Open in VS Code, Copy, Cut, Paste, Rename, Delete, Properties
- Catppuccin Mocha Dark Theme integration
==============================================================================
"""
import glob
import json
import mimetypes
import os
import shutil
import stat
import subprocess
import sys
import time

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, Gio


def ensure_hypr_env():
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        uid = getattr(os, "getuid", lambda: 1000)()
        candidates = [
            os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}"),
            f"/run/user/{uid}",
            "/run/user/1000",
        ]
        for rt in candidates:
            if not rt or not os.path.exists(rt):
                continue
            matches = glob.glob(f"{rt}/hypr/*/.socket.sock") + glob.glob("/tmp/hypr/*/.socket.sock")
            if matches:
                matches.sort(key=os.path.getmtime, reverse=True)
                sig = os.path.basename(os.path.dirname(matches[0]))
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig
                os.environ["XDG_RUNTIME_DIR"] = rt
                break


ensure_hypr_env()


def format_size(bytes_val):
    if bytes_val < 1024:
        return f"{bytes_val} B"
    elif bytes_val < 1024 * 1024:
        return f"{bytes_val / 1024:.1f} KB"
    elif bytes_val < 1024 * 1024 * 1024:
        return f"{bytes_val / (1024 * 1024):.1f} MB"
    else:
        return f"{bytes_val / (1024 * 1024 * 1024):.2f} GB"


