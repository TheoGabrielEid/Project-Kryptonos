#!/usr/bin/env python3
"""
KryptonOS Wayland Background Layer Renderer (GTK 3.0 + GtkLayerShell 0.1 + GdkPixbuf)
Draws the desktop wallpaper on the Wayland BACKGROUND layer using Cairo (CPU/SHM),
which works 100% reliably on VMware svga/vmwgfx where hyprpaper's GLES3.0 shader fails.
"""
import os
import sys
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GdkPixbuf, GtkLayerShell


class WallpaperLayerWindow(Gtk.Window):
    def __init__(self, image_path):
        super().__init__()
        self.image_path = image_path
        self.pixbuf = GdkPixbuf.Pixbuf.new_from_file(image_path)
        self.scaled_cache = {}

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BACKGROUND)
        GtkLayerShell.set_namespace(self, "krypton-wallpaper")
        GtkLayerShell.set_exclusive_zone(self, -1)

        for edge in (
            GtkLayerShell.Edge.TOP,
            GtkLayerShell.Edge.BOTTOM,
            GtkLayerShell.Edge.LEFT,
            GtkLayerShell.Edge.RIGHT,
        ):
            GtkLayerShell.set_anchor(self, edge, True)

        self.set_app_paintable(True)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        alloc = self.get_allocation()
        w = max(1, alloc.width)
        h = max(1, alloc.height)
        key = (w, h)
        if key not in self.scaled_cache:
            self.scaled_cache.clear()
            # Aspect-fill (cover) scaling
            iw = self.pixbuf.get_width()
            ih = self.pixbuf.get_height()
            scale = max(w / iw, h / ih)
            sw = max(w, int(iw * scale))
            sh = max(h, int(ih * scale))
            scaled = self.pixbuf.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
            ox = max(0, (sw - w) // 2)
            oy = max(0, (sh - h) // 2)
            sub = scaled.new_subpixbuf(ox, oy, w, h)
            self.scaled_cache[key] = sub

        Gdk.cairo_set_source_pixbuf(cr, self.scaled_cache[key], 0, 0)
        cr.paint()
        return True


def main():
    img_path = sys.argv[1] if len(sys.argv) > 1 else "/usr/share/backgrounds/krypton/krypton-default.png"
    if not os.path.exists(img_path):
        sys.exit(0)
    win = WallpaperLayerWindow(img_path)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
