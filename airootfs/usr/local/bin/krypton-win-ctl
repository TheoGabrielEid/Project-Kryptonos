#!/usr/bin/env bash
# ==============================================================================
# KryptonOS Universal Window Controls & Mode Manager
# Actions:
#   close [addr] | maximize [addr] | minimize [addr] | restore [addr]
#   toggle-float [addr] | get-mode | set-mode <windows|hyprland> | toggle-mode | status
# ==============================================================================
ACTION="${1:-status}"
ARG="${2:-}"
USER_HOME="${HOME:-/home/krypton}"
MODE_FILE="$USER_HOME/.config/hypr/.window_mode"
MODE_CONF="$USER_HOME/.config/hypr/window_mode.conf"

# Auto-discover HYPRLAND_INSTANCE_SIGNATURE & XDG_RUNTIME_DIR if missing
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    UID_NUM=$(id -u)
    for rt in "${XDG_RUNTIME_DIR:-}" "/run/user/${UID_NUM}" "/run/user/1000"; do
        [ -z "$rt" ] && continue
        for d in "$rt/hypr"/* "/tmp/hypr"/*; do
            if [ -S "${d}/.socket.sock" ] || [ -S "${d}/.socket2.sock" ]; then
                export HYPRLAND_INSTANCE_SIGNATURE=$(basename "$d")
                export XDG_RUNTIME_DIR="$rt"
                break 2
            fi
        done
    done
fi

format_addr() {
    local a="$1"
    if [ -n "$a" ]; then
        local raw="${a#address:}"
        if [[ "$raw" != 0x* ]]; then
            raw="0x$raw"
        fi
        if [[ ! "$raw" =~ ^0x[0-9a-fA-F]+$ ]]; then
            echo ""
            return 1
        fi
        echo "address:$raw"
    fi
}

get_current_mode() {
    if [ -f "$MODE_FILE" ]; then
        cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]'
    else
        echo "hyprland"
    fi
}

set_window_mode() {
    local target="$1"
    if [ "$target" != "windows" ]; then
        target="hyprland"
    fi

    mkdir -p "$USER_HOME/.config/hypr"
    echo "$target" > "$MODE_FILE"

    # Also persist to /etc/skel so all future sessions inherit it
    mkdir -p /etc/skel/.config/hypr 2>/dev/null || true
    echo "$target" > /etc/skel/.config/hypr/.window_mode 2>/dev/null || true

    if [ "$target" = "windows" ]; then
        cat << 'EOF' > "$MODE_CONF"
# ==============================================================================
# KryptonOS Window Mode: Windows Style (Floating & Resizable)
# ==============================================================================
windowrule = float 1, match:class .*

general {
    layout = dwindle
    resize_on_border = true
    extend_border_grab_area = 15
    hover_icon_on_border = true
}
EOF
        cp -f "$MODE_CONF" /etc/skel/.config/hypr/window_mode.conf 2>/dev/null || true

        # Reload Hyprland to apply configuration
        hyprctl reload >/dev/null 2>&1 || true

        # Ensure window mode daemon is running
        if ! pgrep -f krypton-window-mode-daemon >/dev/null 2>&1; then
            (nohup python3 /usr/local/bin/krypton-window-mode-daemon >/dev/null 2>&1 &)
        else
            pkill -USR1 -f krypton-window-mode-daemon 2>/dev/null || true
        fi

        # Float all currently open windows
        if command -v jq >/dev/null 2>&1; then
            for addr in $(hyprctl clients -j 2>/dev/null | jq -r '.[].address // empty'); do
                hyprctl dispatch setfloating "address:${addr}" >/dev/null 2>&1 || true
            done
        fi

        notify-send "Window Mode: Windows Style" "Floating windows active. Drag titlebars or borders to move and resize." --icon=preferences-system -u normal 2>/dev/null || true
    else
        cat << 'EOF' > "$MODE_CONF"
# ==============================================================================
# KryptonOS Window Mode: Hyprland Tiling (Automatic Grid)
# ==============================================================================
general {
    layout = dwindle
    resize_on_border = true
    extend_border_grab_area = 15
    hover_icon_on_border = true
}

dwindle {
    preserve_split = true
    smart_split = false
    smart_resizing = true
}
EOF
        cp -f "$MODE_CONF" /etc/skel/.config/hypr/window_mode.conf 2>/dev/null || true

        # Reload Hyprland to apply configuration
        hyprctl reload >/dev/null 2>&1 || true

        # Ensure window mode daemon is running
        if ! pgrep -f krypton-window-mode-daemon >/dev/null 2>&1; then
            (nohup python3 /usr/local/bin/krypton-window-mode-daemon >/dev/null 2>&1 &)
        else
            pkill -USR1 -f krypton-window-mode-daemon 2>/dev/null || true
        fi

        # Tile all open regular app and system app windows
        if command -v jq >/dev/null 2>&1; then
            for addr in $(hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class != "polkit-gnome-authentication-agent-1" and .class != "scratchpad") | .address // empty'); do
                hyprctl dispatch settiled "address:${addr}" >/dev/null 2>&1 || true
            done
        fi

        notify-send "Window Mode: Hyprland Tiling" "Dynamic auto-tiling grid active with zero wasted screen space." --icon=preferences-system -u normal 2>/dev/null || true
    fi

    # Trigger dock to refresh mode button
    pkill -USR1 -f krypton-dock 2>/dev/null || true
    sync 2>/dev/null || true
}

case "$ACTION" in
    close)
        TARGET_ADDR=$(format_addr "${ARG:-}")
        if [ -n "$TARGET_ADDR" ]; then
            hyprctl dispatch closewindow "${TARGET_ADDR}"
        else
            hyprctl dispatch killactive
        fi
        ;;
    maximize|fullscreen)
        TARGET_ADDR=$(format_addr "${ARG:-}")
        if [ -n "$TARGET_ADDR" ]; then
            hyprctl dispatch focuswindow "${TARGET_ADDR}"
        fi
        hyprctl dispatch fullscreen 1
        ;;
    minimize)
        TARGET_ADDR=$(format_addr "${ARG:-}")
        if [ -n "$TARGET_ADDR" ]; then
            hyprctl dispatch focuswindow "${TARGET_ADDR}"
        fi
        hyprctl dispatch movetoworkspacesilent special:minimized
        ;;
    restore)
        TARGET_ADDR=$(format_addr "${ARG:-}")
        if [ -n "$TARGET_ADDR" ]; then
            hyprctl dispatch movetoworkspace "+0,${TARGET_ADDR}"
            hyprctl dispatch focuswindow "${TARGET_ADDR}"
        else
            hyprctl dispatch togglespecialworkspace minimized
        fi
        ;;
    toggle-float)
        TARGET_ADDR=$(format_addr "${ARG:-}")
        if [ -n "$TARGET_ADDR" ]; then
            hyprctl dispatch focuswindow "${TARGET_ADDR}"
        fi
        hyprctl dispatch togglefloating
        ;;
    get-mode|status)
        get_current_mode
        ;;
    set-mode)
        set_window_mode "${ARG:-hyprland}"
        ;;
    toggle-mode)
        CUR=$(get_current_mode)
        if [ "$CUR" = "windows" ]; then
            set_window_mode "hyprland"
        else
            set_window_mode "windows"
        fi
        ;;
    *)
        hyprctl dispatch killactive
        ;;
esac
