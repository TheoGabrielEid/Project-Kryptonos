#!/usr/bin/env bash
# KryptonOS Custom URL & Action Handler
URL="$1"
case "$URL" in
    *krypton-action:minimize*|*krypton-action%3Aminimize*)
        /usr/local/bin/krypton-win-ctl minimize
        ;;
    *krypton-action:fullscreen*|*krypton-action%3Afullscreen*|*krypton-action:maximize*|*krypton-action%3Amaximize*)
        /usr/local/bin/krypton-win-ctl fullscreen
        ;;
    *krypton-action:close*|*krypton-action%3Aclose*|*krypton-action:exit*|*krypton-action%3Aexit*)
        /usr/local/bin/krypton-win-ctl close
        ;;
    http://*|https://*|ftp://*|mailto:*)
        helium-browser "$URL" &
        ;;
    file://*)
        helium-browser "$URL" &
        ;;
    *)
        echo "Blocked unsupported or unsafe URL scheme: $URL" >&2
        exit 1
        ;;
esac
