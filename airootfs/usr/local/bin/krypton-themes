#!/usr/bin/env python3
"""
KryptonOS Theme Studio & Customizer (GTK 3.0)
Allows choosing preset developer themes or crafting custom desktop themes.
Live updates Hyprland, Waybar, Kitty Terminal, Dock, and Wallpapers.
"""
import json
import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

