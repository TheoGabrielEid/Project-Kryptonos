#!/usr/bin/env bash
# ==============================================================================
# KryptonOS Interactive Power Menu (Rofi)
# ==============================================================================

options="  Lock\n󰍃  Logout\n󰒲  Suspend\n󰜉  Reboot\n  Shutdown"

chosen="$(echo -e "$options" | rofi -dmenu -i -p "Power" -theme-str 'window {width: 260px; height: 260px;}')"

case "$chosen" in
    "  Lock")
        hyprlock
        ;;
    "󰍃  Logout")
        hyprctl dispatch exit
        ;;
    "󰒲  Suspend")
        systemctl suspend
        ;;
    "󰜉  Reboot")
        systemctl reboot
        ;;
    "  Shutdown")
        systemctl poweroff
        ;;
esac
