    def build_display_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        sec1 = make_section(
            "Monitor, Resolution & Refresh Rate (FPS)",
            f"Active Output: {self.active_monitor} — Saved permanently across reboots.",
        )

        self.res_combo = Gtk.ComboBoxText()
        for label, _ in RESOLUTIONS:
            self.res_combo.append_text(label)

        self.fps_combo = Gtk.ComboBoxText()
        for label, _ in REFRESH_RATES:
            self.fps_combo.append_text(label)

        self.scale_combo = Gtk.ComboBoxText()
        for label, _ in SCALES:
            self.scale_combo.append_text(label)

        # Detect active configuration from ~/.config/hypr/monitors.conf
        conf_res = "preferred"
        conf_fps = "60"
        conf_scale = "1"
        mon_conf_path = os.path.expanduser("~/.config/hypr/monitors.conf")
        if os.path.exists(mon_conf_path):
            try:
                with open(mon_conf_path, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("monitor") and "=" in line:
                            parts = [p.strip() for p in line.split("=", 1)[1].split(",")]
                            if len(parts) >= 2:
                                mode_part = parts[1]
                                if mode_part == "preferred":
                                    conf_res = "preferred"
                                else:
                                    if "@" in mode_part:
                                        r, f_val = mode_part.split("@", 1)
                                        conf_res = r
                                        conf_fps = f_val
                                    else:
                                        conf_res = mode_part
                            if len(parts) >= 4:
                                conf_scale = parts[3]
            except Exception:
                pass

        # Select corresponding index in res_combo
        res_idx = 0
        for idx, (_, val) in enumerate(RESOLUTIONS):
            if val == conf_res:
                res_idx = idx
                break
        self.res_combo.set_active(res_idx)

        # Select corresponding index in fps_combo
        fps_idx = 5
        for idx, (_, val) in enumerate(REFRESH_RATES):
            if val == conf_fps:
                fps_idx = idx
                break
        self.fps_combo.set_active(fps_idx)

        # Select corresponding index in scale_combo
        scale_idx = 0
        for idx, (_, val) in enumerate(SCALES):
            if val == conf_scale:
                scale_idx = idx
                break
        self.scale_combo.set_active(scale_idx)

        sec1.pack_start(make_row("Screen Resolution", "Choose resolution or fit to entire screen", self.res_combo), False, False, 0)
        sec1.pack_start(make_row("Refresh Rate / Target FPS", "Set display refresh rate (Hz / FPS)", self.fps_combo), False, False, 0)
        sec1.pack_start(make_row("Display Scaling (HiDPI)", "Adjust UI & text sharpness", self.scale_combo), False, False, 0)

        apply_btn = Gtk.Button(label="Apply & Save Permanently")
        apply_btn.get_style_context().add_class("primary-btn")
        apply_btn.connect("clicked", self.on_apply_display)
        sec1.pack_start(make_row("Apply Display Configuration", "Updates live session & saves permanently", apply_btn), False, False, 0)
        page.pack_start(sec1, False, False, 0)

        sec2 = make_section("One-Click Display Presets", "Instant presets for your display")
        presets = [
            ("Auto / Fit to Window (Recommended)", "preferred", "60", "1"),
            ("Fit Native Fullscreen (2560x1600 @ 240Hz)", "2560x1600", "240", "1"),
            ("Fit Native Fullscreen HiDPI (2560x1600 @ 240Hz, 1.25x Scale)", "2560x1600", "240", "1.25"),
            ("Fit 16:10 Fullscreen (1920x1200 @ 120Hz)", "1920x1200", "120", "1"),
            ("Fit 16:9 Full HD (1920x1080 @ 120Hz)", "1920x1080", "120", "1"),
        ]
        for title, res, fps, scale in presets:
            btn = Gtk.Button(label="Activate")
            btn.get_style_context().add_class("action-btn")
            btn.connect("clicked", lambda _, r=res, f=fps, s=scale: self.apply_display_values(r, f, s))
            sec2.pack_start(make_row(title, f"{res} @ {fps}Hz (Scale {scale}x)", btn), False, False, 0)
        page.pack_start(sec2, False, False, 0)

        self.stack.add_titled(self.wrap_scrolled(page), "display", "Display & FPS")

