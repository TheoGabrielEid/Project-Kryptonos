        card_hypr.pack_start(btn_hypr, False, False, 0)
        grid.attach(card_hypr, 1, 0, 1, 1)

        page.pack_start(grid, False, False, 0)

        # Connect button click handlers
        def apply_mode(target):
            subprocess.run(["/usr/local/bin/krypton-win-ctl", "set-mode", target], check=False)
            card_win.get_style_context().remove_class("mode-card-active")
            card_win.get_style_context().remove_class("mode-card")
            card_hypr.get_style_context().remove_class("mode-card-active")
            card_hypr.get_style_context().remove_class("mode-card")
            btn_win.get_style_context().remove_class("primary-btn")
            btn_win.get_style_context().remove_class("action-btn")
            btn_hypr.get_style_context().remove_class("primary-btn")
            btn_hypr.get_style_context().remove_class("action-btn")

            if target == "windows":
                card_win.get_style_context().add_class("mode-card-active")
                card_hypr.get_style_context().add_class("mode-card")
                btn_win.set_label("✅ Active (Windows Style)")
                btn_win.get_style_context().add_class("primary-btn")
                btn_hypr.set_label("Apply Hyprland Tiling")
                btn_hypr.get_style_context().add_class("action-btn")
                self.notify("Switched to Windows Style: Floating & Resizable Desktops!")
            else:
                card_hypr.get_style_context().add_class("mode-card-active")
                card_win.get_style_context().add_class("mode-card")
                btn_hypr.set_label("✅ Active (Hyprland Tiling)")
                btn_hypr.get_style_context().add_class("primary-btn")
                btn_win.set_label("Apply Windows Style")
                btn_win.get_style_context().add_class("action-btn")
                self.notify("Switched to Hyprland Tiling: Smart Auto-Split Grid!")

        btn_win.connect("clicked", lambda _: apply_mode("windows"))
        btn_hypr.connect("clicked", lambda _: apply_mode("hyprland"))

