        os.makedirs(user_wall_dir, exist_ok=True)
        for ext in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
            for img in sorted(glob.glob(os.path.join(user_wall_dir, ext))):
                name = os.path.basename(img)
                btn = Gtk.Button(label="Set Wallpaper")
                btn.get_style_context().add_class("action-btn")
