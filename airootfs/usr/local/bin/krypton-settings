                sec2.pack_start(make_row(name, img, btn), False, False, 0)

        open_btn = Gtk.Button(label="Open Folder in Thunar")
        open_btn.get_style_context().add_class("action-btn")
        open_btn.connect("clicked", lambda _: subprocess.Popen(f"thunar '{user_wall_dir}'", shell=True))
        sec2.pack_start(make_row("Open Wallpapers Folder", user_wall_dir, open_btn), False, False, 0)
        page.pack_start(sec2, False, False, 0)

        self.stack.add_titled(self.wrap_scrolled(page), "wallpapers", "Wallpapers")

    def set_wallpaper(self, path, title):
        hp_conf = os.path.expanduser("~/.config/hypr/hyprpaper.conf")
        os.makedirs(os.path.dirname(hp_conf), exist_ok=True)
        conf_text = (
            "# KryptonOS Wallpaper Configuration (hyprpaper 0.8+)\n"
            "splash = false\n"
            "ipc = true\n\n"
            "wallpaper {\n"
            "    monitor = \n"
            f"    path = {path}\n"
            "    fit_mode = cover\n"
            "}\n"
        )
        try:
            with open(hp_conf, "w", encoding="utf-8") as f:
                f.write(conf_text)
        except Exception:
            pass

        subprocess.Popen(f"/usr/local/bin/krypton-wallpaper '{path}'", shell=True)
        subprocess.run("sync", shell=True)
        self.notify(f"Wallpaper set to: {title}")

