            ("Full Screen / Maximize", "Toggle fullscreen for active window (F11 or Super+F / Super+M)", "Super + F  /  Super + M"),
            ("Minimize Window", "Minimize active window to tray (Super+I)", "Super + I"),
            ("Restore Minimized Window", "Bring back minimized window (Super+Shift+I)", "Super + Shift + I"),
