def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5)
        return res.stdout.strip()
    except Exception:
        return ""


def get_monitors():
    out = run_cmd("hyprctl monitors -j")
    try:
        data = json.loads(out)
        if isinstance(data, list) and len(data) > 0:
            return data
    except Exception:
        pass
    return [{"name": "Virtual-1", "width": 1920, "height": 1200, "refreshRate": 60.0, "scale": 1.0}]


def get_persistence_status():
    out = run_cmd("df -h /run/archiso/cowspace 2>/dev/null | tail -n 1")
    if "/dev/nvme" in out or "/dev/sd" in out or "/dev/vd" in out:
        parts = out.split()
        dev = parts[0] if parts else "Disk"
        size = parts[1] if len(parts) > 1 else "64G"
        used = parts[2] if len(parts) > 2 else ""
        return f"Permanent Disk Persistence Active ({dev} — {used} used of {size})"
    return "Permanent Disk Overlay Active"


def make_section(title, subtitle=""):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.get_style_context().add_class("card")
    lbl = Gtk.Label(label=title, xalign=0)
    lbl.get_style_context().add_class("section-title")
    box.pack_start(lbl, False, False, 0)
    if subtitle:
        sub = Gtk.Label(label=subtitle, xalign=0)
        sub.get_style_context().add_class("row-subtitle")
        box.pack_start(sub, False, False, 0)
    return box


def make_row(title, subtitle, widget):
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    row.set_margin_top(4)
    row.set_margin_bottom(4)
    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    t = Gtk.Label(label=title, xalign=0)
    t.get_style_context().add_class("row-title")
    vbox.pack_start(t, False, False, 0)
    if subtitle:
        s = Gtk.Label(label=subtitle, xalign=0)
        s.get_style_context().add_class("row-subtitle")
        vbox.pack_start(s, False, False, 0)
    row.pack_start(vbox, True, True, 0)
    widget.set_valign(Gtk.Align.CENTER)
    row.pack_end(widget, False, False, 0)
    return row


class KryptonSettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="KryptonOS System Settings")
        self.set_wmclass("krypton-settings", "KryptonSettings")
        self.set_default_size(860, 660)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.monitors = get_monitors()
        self.active_monitor = self.monitors[0].get("name", "Virtual-1")

        # HeaderBar + StackSwitcher (with explicit Minimize, Maximize/Fullscreen, and Close buttons)
        header = Gtk.HeaderBar()
        header.set_show_close_button(False)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        switcher = Gtk.StackSwitcher()
        switcher.set_stack(self.stack)
        header.set_custom_title(switcher)

        close_btn = Gtk.Button(label="✕")
        close_btn.set_tooltip_text("Close / Exit Settings")
        close_btn.get_style_context().add_class("action-btn")
        close_btn.connect("clicked", lambda _: self.close())

        max_btn = Gtk.Button(label="🗖")
        max_btn.set_tooltip_text("Maximize / Fullscreen")
        max_btn.get_style_context().add_class("action-btn")
        max_btn.connect("clicked", lambda _: subprocess.Popen(["/usr/local/bin/krypton-win-ctl", "maximize"]))

        min_btn = Gtk.Button(label="🗕")
        min_btn.set_tooltip_text("Minimize Window")
        min_btn.get_style_context().add_class("action-btn")
        min_btn.connect("clicked", lambda _: subprocess.Popen(["/usr/local/bin/krypton-win-ctl", "minimize"]))

        header.pack_end(close_btn)
        header.pack_end(max_btn)
        header.pack_end(min_btn)
        self.set_titlebar(header)

        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_vbox)

        self.status_label = Gtk.Label(
            label="💎 KryptonOS Control Center — Changes apply live & save permanently to disk",
            xalign=0.5,
        )
        self.status_label.get_style_context().add_class("status-banner")
        self.status_label.set_margin_top(10)
        self.status_label.set_margin_start(16)
        self.status_label.set_margin_end(16)
        main_vbox.pack_start(self.status_label, False, False, 0)

        main_vbox.pack_start(self.stack, True, True, 0)

        self.build_coding_workspace_page()
        self.build_window_modes_page()
        self.build_display_page()
        self.build_wallpaper_page()
        self.build_performance_page()
        self.build_users_page()
        self.build_system_page()

    def notify(self, msg):
        self.status_label.set_text(f"✅  {msg}")
        subprocess.Popen(f"notify-send 'KryptonOS Settings' '{msg}' --icon=preferences-system", shell=True)

    def wrap_scrolled(self, content_box):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        content_box.set_margin_top(14)
        content_box.set_margin_bottom(20)
        content_box.set_margin_start(18)
        content_box.set_margin_end(18)
        scrolled.add(content_box)
        return scrolled

    def build_coding_workspace_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        intro = make_section(
            "Coding Workspace & Developer Environment",
            "KryptonOS is pre-tuned for high-performance development with native compilers, container runtimes, and fast terminal tooling.",
        )
        page.pack_start(intro, False, False, 0)

        # 1. Quick Launch Actions
        actions_sec = make_section(
            "Developer Launchpad",
            "Launch your core IDEs, project scaffolders, and terminal tools instantly.",
        )
        dev_tools = [
            ("New Project Scaffolder", "Generate Rust, Python, Go, TypeScript, C/C++, or Web projects", "Scaffold", lambda: subprocess.Popen(["kitty", "--class", "kproj", "-e", "krypton-project"])),
            ("Neovim Lua IDE", "Launch pre-configured Neovim with Catppuccin theme and Netrw tree", "Launch", lambda: subprocess.Popen(["kitty", "--class", "nvim", "-e", "nvim"])),
            ("Visual Studio Code", "Open VS Code with JetBrains Mono ligatures & dark theme", "Launch", lambda: subprocess.Popen(["code", "--no-sandbox"])),
            ("Scratchpad Terminal", "Toggle dropdown floating terminal (or press Super + ` / F12)", "Toggle", lambda: subprocess.Popen(["hyprctl", "dispatch", "togglespecialworkspace", "scratchpad"])),
            ("LazyGit Interface", "Interactive terminal git staging, commit, and branching GUI", "Launch", lambda: subprocess.Popen(["kitty", "--class", "lazygit", "-e", "lazygit"])),
        ]
        for title, subtitle, btn_label, callback in dev_tools:
            btn = Gtk.Button(label=btn_label)
            btn.get_style_context().add_class("primary-btn" if "Scaffold" in btn_label else "action-btn")
            btn.connect("clicked", lambda _, cb=callback: cb())
            actions_sec.pack_start(make_row(title, subtitle, btn), False, False, 0)
        page.pack_start(actions_sec, False, False, 0)

        # 2. Git Identity Configuration
        git_sec = make_section(
            "Git Identity Configuration",
            "Set your global commit author name and email permanently across all repositories.",
        )
        cur_git_name = run_cmd("git config --global user.name") or ""
        cur_git_email = run_cmd("git config --global user.email") or ""

        self.git_name_entry = Gtk.Entry()
        self.git_name_entry.set_placeholder_text("e.g. Linus Torvalds")
        self.git_name_entry.set_text(cur_git_name)
        self.git_name_entry.set_width_chars(25)
        git_sec.pack_start(make_row("Author Name", "Display name used for git commits", self.git_name_entry), False, False, 0)

        self.git_email_entry = Gtk.Entry()
        self.git_email_entry.set_placeholder_text("e.g. developer@example.com")
        self.git_email_entry.set_text(cur_git_email)
        self.git_email_entry.set_width_chars(25)
        git_sec.pack_start(make_row("Author Email", "Email address associated with git commits", self.git_email_entry), False, False, 0)

        save_git_btn = Gtk.Button(label="Save Git Identity")
        save_git_btn.get_style_context().add_class("primary-btn")
        save_git_btn.connect("clicked", self.on_save_git_identity)
        git_sec.pack_start(make_row("Apply Git Configuration", "Saves to ~/.gitconfig", save_git_btn), False, False, 0)
        page.pack_start(git_sec, False, False, 0)

        # 3. Installed Compilers & Runtimes
        toolchain_sec = make_section(
            "Detected Compilers & Toolchains",
            "System status of installed language runtimes and build tools.",
        )
        toolchains = [
            ("Python 3", "python3 --version"),
            ("Rust / Cargo", "rustc --version"),
            ("Go (Golang)", "go version"),
            ("Node.js (JavaScript / TypeScript)", "node --version"),
            ("GCC C/C++ Compiler", "gcc --version"),
            ("Git VCS", "git --version"),
            ("Docker Engine", "docker --version"),
        ]
        for name, cmd in toolchains:
            ver = run_cmd(cmd)
            if ver:
                ver_line = ver.splitlines()[0]
                if len(ver_line) > 35:
                    ver_line = ver_line[:32] + "..."
                badge = Gtk.Label(label=f" {ver_line} ")
                badge.get_style_context().add_class("status-banner")
            else:
                badge = Gtk.Label(label=" Not Installed ")
            toolchain_sec.pack_start(make_row(name, f"Command: {cmd.split()[0]}", badge), False, False, 0)
        page.pack_start(toolchain_sec, False, False, 0)

        # 4. Keyboard Shortcuts Reference
        shortcuts_sec = make_section(
            "Developer Shortcuts Reference",
            "Key combinations optimized for split tiling and fast developer navigation.",
        )
        shortcuts = [
            ("Visual Studio Code", "Open VS Code editor", "Super + C"),
            ("Neovim Lua IDE", "Open terminal-based Neovim", "Super + N"),
            ("Scratchpad Terminal", "Dropdown Quake-style terminal", "Super + `  /  F12"),
            ("Project Scaffolder", "Create new Rust, Go, Python, Node, C project", "Super + Shift + P"),
            ("Kitty Terminal", "Launch main GPU-accelerated terminal", "Super + Return"),
            ("LazyGit TUI", "Git staging, branching & committing", "Super + G"),
            ("Yazi File Manager", "Fast terminal file browser with previews", "Super + Y"),
            ("Btop System Monitor", "CPU, memory, disk, and process stats", "Super + T"),
            ("Toggle Dwindle Split", "Change split direction between horizontal & vertical", "Super + D"),
            ("Toggle Floating Mode", "Switch between tiling and floating window", "Super + W"),
            ("Wayland Clipboard", "Fuzzy search and paste clipboard history", "Super + V"),
            ("Application Finder", "Search and launch any system program", "Super + Space"),
        ]
        for title, subtitle, badge_text in shortcuts:
            badge = Gtk.Label(label=f" {badge_text} ")
            badge.get_style_context().add_class("status-banner")
            shortcuts_sec.pack_start(make_row(title, subtitle, badge), False, False, 0)
        page.pack_start(shortcuts_sec, False, False, 0)

        self.stack.add_titled(self.wrap_scrolled(page), "coding_workspace", "Coding Workspace")

    def build_window_modes_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        sec_intro = make_section(
            "Window Management Style & Desktop Workflow",
            "Switch seamlessly between Windows Style (free-floating, draggable, edge-resizable windows with titlebars) and Hyprland Tiling (smart automatic split-grid windows).",
        )
        page.pack_start(sec_intro, False, False, 0)

        # Mode Selection Grid with Visual Previews
        grid = Gtk.Grid()
        grid.set_column_spacing(16)
        grid.set_row_spacing(16)
        grid.set_column_homogeneous(True)

        cur_mode = run_cmd("/usr/local/bin/krypton-win-ctl get-mode") or "hyprland"

        # Card 1: Windows Style
        card_win = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card_win.get_style_context().add_class("mode-card-active" if cur_mode == "windows" else "mode-card")

        lbl_win_title = Gtk.Label(label="🪟 Windows Style (Floating & Resizable)", xalign=0)
        lbl_win_title.get_style_context().add_class("section-title")
        card_win.pack_start(lbl_win_title, False, False, 0)

        lbl_win_desc = Gtk.Label(
            label="• Free-floating windows just like Microsoft Windows / macOS\n• Drag window titlebar or Super+LeftClick to move\n• Drag window borders or Super+RightClick to resize\n• Minimize, Maximize, Close controls on every app\n• Overlapping windows with independent sizes",
            xalign=0,
        )
        lbl_win_desc.get_style_context().add_class("row-subtitle")
        card_win.pack_start(lbl_win_desc, False, False, 0)

        # Visual preview drawing area for Windows style
        darea_win = Gtk.DrawingArea()
        darea_win.set_size_request(-1, 140)
        darea_win.get_style_context().add_class("mode-preview-box")
        def draw_windows_preview(widget, cr):
            alloc = widget.get_allocation()
            w, h = alloc.width, alloc.height
            # Desktop background
            cr.set_source_rgb(0.07, 0.07, 0.11)
            cr.paint()
            # Top panel/bar
            cr.set_source_rgb(0.12, 0.12, 0.18)
            cr.rectangle(0, 0, w, 16)
            cr.fill()
            # Window 1 (back, left)
            cr.set_source_rgb(0.16, 0.16, 0.24)
            cr.rectangle(16, 26, w * 0.52, h * 0.65)
            cr.fill()
            cr.set_source_rgb(0.25, 0.25, 0.35)
            cr.set_line_width(2)
            cr.stroke()
            # Window 1 titlebar
            cr.set_source_rgb(0.20, 0.20, 0.30)
            cr.rectangle(16, 26, w * 0.52, 14)
            cr.fill()
            # Window 1 buttons
            cr.set_source_rgb(0.95, 0.55, 0.66)
            cr.arc(16 + w * 0.52 - 8, 33, 3, 0, 6.28)
            cr.fill()

            # Window 2 (front, right - overlapping)
            cr.set_source_rgb(0.18, 0.18, 0.28)
            cr.rectangle(w * 0.35, 42, w * 0.55, h * 0.68)
            cr.fill()
            cr.set_source_rgb(0.79, 0.65, 0.97) # Active purple border
            cr.set_line_width(2)
            cr.stroke()
            # Window 2 titlebar
            cr.set_source_rgb(0.24, 0.24, 0.36)
            cr.rectangle(w * 0.35, 42, w * 0.55, 16)
            cr.fill()
            # Window 2 buttons (Min, Max, Close)
            cr.set_source_rgb(0.65, 0.89, 0.63)
            cr.arc(w * 0.35 + w * 0.55 - 24, 50, 3, 0, 6.28)
            cr.fill()
            cr.set_source_rgb(0.98, 0.89, 0.69)
            cr.arc(w * 0.35 + w * 0.55 - 16, 50, 3, 0, 6.28)
            cr.fill()
            cr.set_source_rgb(0.95, 0.55, 0.66)
            cr.arc(w * 0.35 + w * 0.55 - 8, 50, 3, 0, 6.28)
            cr.fill()
            return True
        darea_win.connect("draw", draw_windows_preview)
        card_win.pack_start(darea_win, False, False, 0)

        btn_win = Gtk.Button(label="✅ Active (Windows Style)" if cur_mode == "windows" else "Apply Windows Style")
        btn_win.get_style_context().add_class("primary-btn" if cur_mode == "windows" else "action-btn")
        card_win.pack_start(btn_win, False, False, 0)
        grid.attach(card_win, 0, 0, 1, 1)

        # Card 2: Hyprland Tiling
        card_hypr = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card_hypr.get_style_context().add_class("mode-card-active" if cur_mode == "hyprland" else "mode-card")

        lbl_hypr_title = Gtk.Label(label="🔲 Hyprland Tiling (Automatic Grid)", xalign=0)
        lbl_hypr_title.get_style_context().add_class("section-title")
        card_hypr.pack_start(lbl_hypr_title, False, False, 0)

        lbl_hypr_desc = Gtk.Label(
            label="• Smart dynamic tiling layout (Dwindle auto-splitting)\n• Windows neatly tile side-by-side with zero wasted space\n• Drag windows with Super+LeftClick to swap layout positions\n• Resize tiling splits with Super+RightClick or border drag\n• Fast keyboard-driven workflow with instant focus navigation",
            xalign=0,
        )
        lbl_hypr_desc.get_style_context().add_class("row-subtitle")
        card_hypr.pack_start(lbl_hypr_desc, False, False, 0)

        # Visual preview drawing area for Hyprland tiling
        darea_hypr = Gtk.DrawingArea()
        darea_hypr.set_size_request(-1, 140)
        darea_hypr.get_style_context().add_class("mode-preview-box")
        def draw_hypr_preview(widget, cr):
            alloc = widget.get_allocation()
            w, h = alloc.width, alloc.height
            # Desktop background
            cr.set_source_rgb(0.07, 0.07, 0.11)
            cr.paint()
            # Top panel/bar
            cr.set_source_rgb(0.12, 0.12, 0.18)
            cr.rectangle(0, 0, w, 16)
            cr.fill()
            gap = 6
            top_y = 22
            avail_h = h - top_y - gap
            # Left Master Tile
            tile1_w = (w - (gap * 3)) * 0.5
            cr.set_source_rgb(0.18, 0.18, 0.28)
            cr.rectangle(gap, top_y, tile1_w, avail_h)
            cr.fill()
            cr.set_source_rgb(0.79, 0.65, 0.97) # Active purple border
            cr.set_line_width(2)
            cr.stroke()

            # Right Top Subtile
            tile2_x = gap + tile1_w + gap
            tile2_w = (w - (gap * 3)) * 0.5
            tile2_h = (avail_h - gap) * 0.5
            cr.set_source_rgb(0.16, 0.16, 0.24)
            cr.rectangle(tile2_x, top_y, tile2_w, tile2_h)
            cr.fill()
            cr.set_source_rgb(0.25, 0.25, 0.35)
            cr.set_line_width(1.5)
            cr.stroke()

            # Right Bottom Subtile
            tile3_y = top_y + tile2_h + gap
            cr.set_source_rgb(0.16, 0.16, 0.24)
            cr.rectangle(tile2_x, tile3_y, tile2_w, tile2_h)
            cr.fill()
            cr.set_source_rgb(0.25, 0.25, 0.35)
            cr.set_line_width(1.5)
            cr.stroke()
            return True
        darea_hypr.connect("draw", draw_hypr_preview)
        card_hypr.pack_start(darea_hypr, False, False, 0)

        btn_hypr = Gtk.Button(label="✅ Active (Hyprland Tiling)" if cur_mode == "hyprland" else "Apply Hyprland Tiling")
