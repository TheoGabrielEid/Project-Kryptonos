    def generate_secure_password(self, length=16):
        import secrets
        import string
        alphabet = string.ascii_letters + string.digits + "!@#$%&*-_=+"
        return "".join(secrets.choice(alphabet) for _ in range(length))

    def generate_password_for_entry(self, entry):
        pwd = self.generate_secure_password(14)
        entry.set_text(pwd)
        entry.set_visibility(True)
        self.copy_to_clipboard(pwd)
        self.notify("Generated secure password & copied to clipboard!")

    def copy_to_clipboard(self, text):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(text, -1)
        clipboard.store()
        try:
            subprocess.run(["wl-copy"], input=text, text=True, check=False)
        except Exception:
            pass
        self.notify("Copied password to clipboard!")

    def refresh_user_list(self):
        self.change_user_combo.remove_all()
        if hasattr(self, "del_user_combo"):
            self.del_user_combo.remove_all()
        users = []
        try:
            with open("/etc/passwd", "r") as f:
                for line in f:
                    parts = line.strip().split(":")
                    if len(parts) >= 3:
                        uname = parts[0]
                        uid = int(parts[2])
                        if uid == 0 or (uid >= 1000 and uid < 60000):
                            users.append(uname)
        except Exception:
            users = ["krypton", "root"]

        if not users:
            users = ["krypton", "root"]

        sorted_users = sorted(users)
        for u in sorted_users:
            self.change_user_combo.append_text(u)
            if hasattr(self, "del_user_combo"):
                self.del_user_combo.append_text(u)

        default_idx = sorted_users.index("krypton") if "krypton" in sorted_users else 0
        self.change_user_combo.set_active(default_idx)
        if hasattr(self, "del_user_combo"):
            self.del_user_combo.set_active(default_idx)

    def verify_user_password(self, uname, entered_pwd):
        if not entered_pwd:
            return False, "⚠️ Please enter the user's current password first to verify!"
        try:
            res = subprocess.run(
                ["sudo", "grep", f"^{uname}:", "/etc/shadow"],
                capture_output=True,
                text=True,
            )
            line = res.stdout.strip()
            if not line:
                return False, f"❌ User '{uname}' not found in /etc/shadow"
            fields = line.split(":")
            pw_hash = fields[1] if len(fields) > 1 else ""
            if pw_hash == "":
                return True, "No password set"
            if pw_hash.startswith("!") or pw_hash.startswith("*"):
                return False, f"❌ Account '{uname}' password is locked"

            # Verify SHA-512 ($6$) or SHA-256 ($5$) or MD5 ($1$) via openssl passwd
            if pw_hash.startswith("$6$") or pw_hash.startswith("$5$") or pw_hash.startswith("$1$"):
                hp = pw_hash.split("$")
                alg = hp[1]
                salt_part = hp[2]
                flag = f"-{alg}"
                chk = subprocess.run(
                    ["openssl", "passwd", flag, "-salt", salt_part, entered_pwd],
                    capture_output=True,
                    text=True,
                )
                if chk.stdout.strip() == pw_hash:
                    return True, "Verified"

            # Fallback verification via su pam authentication (run as unprivileged nobody so root doesn't bypass)
            pam_chk = subprocess.run(
                ["sudo", "-u", "nobody", "su", "-c", "true", uname],
                input=entered_pwd + "\n",
                capture_output=True,
                text=True,
                timeout=5,
            )
            if pam_chk.returncode == 0:
                return True, "Verified"

            return False, f"❌ Incorrect password for '{uname}'! Enter their current password to delete."
        except Exception as e:
            return False, f"❌ Verification error: {e}"

    def on_delete_password_clicked(self, _btn):
        uname = self.del_user_combo.get_active_text()
        entered_pwd = self.verify_pass_entry.get_text()

        if not uname:
            self.notify("⚠️ Please select a user first!")
            return

        ok, msg = self.verify_user_password(uname, entered_pwd)
        if not ok:
            self.notify(msg)
            return

        res = subprocess.run(
            ["sudo", "passwd", "-d", uname],
            capture_output=True,
            text=True,
        )
        subprocess.run(["sudo", "sync"])
        if res.returncode == 0:
            self.verify_pass_entry.set_text("")
            self.notify(f"✅ Password verified & deleted for '{uname}'! Account now has no password.")
        else:
            self.notify(f"❌ Failed to delete password for '{uname}'")

    def on_delete_user_clicked(self, _btn):
        uname = self.del_user_combo.get_active_text()
        entered_pwd = self.verify_pass_entry.get_text()

        if not uname:
            self.notify("⚠️ Please select a user first!")
            return

        if uname == "root":
            self.notify("⚠️ Cannot delete the root system account. Use 'Delete User Password' instead!")
            return

        ok, msg = self.verify_user_password(uname, entered_pwd)
        if not ok:
            self.notify(msg)
            return

        res = subprocess.run(
            ["sudo", "userdel", "-r", "-f", uname],
            capture_output=True,
            text=True,
        )
        subprocess.run(["sudo", "sync"])
        if res.returncode == 0:
            self.verify_pass_entry.set_text("")
            self.refresh_user_list()
            self.notify(f"✅ Password verified & user account '{uname}' deleted!")
        else:
            self.notify(f"❌ Failed to delete user '{uname}'")

    def on_create_user_clicked(self, _btn):
        uname = self.new_user_entry.get_text().strip()
        pwd = self.new_pass_entry.get_text()

        if not uname:
            self.notify("⚠️ Please enter a username first!")
            return

        if not re.match(r"^[a-z_][a-z0-9_-]*$", uname):
            self.notify("⚠️ Invalid username. Use lowercase letters, digits, '_' or '-'")
            return

        if not pwd:
            self.notify("⚠️ Please enter or generate a password!")
            return

        subprocess.run(
            ["sudo", "useradd", "-m", "-k", "/etc/skel", "-s", "/bin/bash", "-G", "wheel,video,audio,input,storage", uname],
            capture_output=True,
        )
        # Ensure password uses SHA-512 (-c SHA512) so openssl passwd -6 verification always works
        res = subprocess.run(
            ["sudo", "chpasswd", "-c", "SHA512"],
            input=f"{uname}:{pwd}\n",
            text=True,
            capture_output=True,
        )
        subprocess.run(["sudo", "sh", "-c", f"echo '{uname} ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/krypton-{uname} && chmod 0440 /etc/sudoers.d/krypton-{uname}"])
        subprocess.run(["sudo", "sync"])
        if res.returncode == 0:
            self.new_user_entry.set_text("")
            self.new_pass_entry.set_text("")
            self.refresh_user_list()
            self.notify(f"User '{uname}' created successfully with password!")
        else:
            self.notify(f"❌ Failed to create user '{uname}'")

    def on_update_password_clicked(self, _btn):
        uname = self.change_user_combo.get_active_text()
        pwd = self.change_pass_entry.get_text()

        if not uname:
            self.notify("⚠️ Please select a user first!")
            return

        if not pwd:
            self.notify("⚠️ Please enter or generate a new password!")
            return

        res = subprocess.run(
            ["sudo", "chpasswd", "-c", "SHA512"],
            input=f"{uname}:{pwd}\n",
            text=True,
            capture_output=True,
        )
        subprocess.run(["sudo", "sync"])
        if res.returncode == 0:
            self.change_pass_entry.set_text("")
            self.notify(f"Password updated successfully for '{uname}'!")
        else:
            self.notify(f"❌ Failed to update password for '{uname}'")

    def build_system_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)

        sec_persist = make_section(
            "Permanent Disk Persistence",
            "All files, wallpapers, settings, and packages save automatically to your 64GB NVMe drive.",
        )
        sync_btn = Gtk.Button(label="Flush to Disk Now")
        sync_btn.get_style_context().add_class("primary-btn")
        sync_btn.connect(
            "clicked",
            lambda _: (subprocess.run("sync", shell=True), self.notify("All data flushed to permanent NVMe disk!")),
        )
        sec_persist.pack_start(make_row("Storage Status", get_persistence_status(), sync_btn), False, False, 0)
        page.pack_start(sec_persist, False, False, 0)

        sec_tools = make_section("Apps, Browser & Hardware Control Panels", "Launch system utilities")
        tools = [
            ("File Explorer (Thunar GUI)", "Graphical file manager with tabs, archives & volume management (Super+E)", "thunar"),
            ("Terminal File Explorer (Yazi)", "Blazing-fast terminal file manager with previews (Super+Shift+E)", "kitty -e yazi"),
            ("Helium Browser (Default Browser)", "Launch privacy-focused Helium Browser (Super+B)", "helium-browser"),
            ("Audio & Microphone Mixer", "Configure speakers, headphones, and input volume", "pavucontrol"),
            ("Network & Wi-Fi Connections", "Manage Ethernet, Wi-Fi, and VPN profiles", "nm-connection-editor"),
            ("Bluetooth Devices", "Pair headphones, controllers, and keyboards", "blueman-manager"),
            ("GTK Theme & Icons (nwg-look)", "Customize GTK themes, cursors, and fonts", "nwg-look"),
            ("Qt6 Theme Settings (qt6ct)", "Customize Qt application appearance", "qt6ct"),
            ("Disk Management (GNOME Disks)", "View partitions and disk health", "gnome-disks"),
            ("System Resource Monitor (btop)", "Live CPU, GPU, RAM, and process monitor", "kitty -e btop"),
        ]
        for title, subtitle, cmd in tools:
            btn = Gtk.Button(label="Open")
            btn.get_style_context().add_class("action-btn")
            btn.connect("clicked", lambda _, c=cmd: subprocess.Popen(c, shell=True))
            sec_tools.pack_start(make_row(title, subtitle, btn), False, False, 0)
        page.pack_start(sec_tools, False, False, 0)

        self.stack.add_titled(self.wrap_scrolled(page), "system", "Storage & Apps")

    def set_hypr_keyword(self, key, val):
        parts = key.split(":")
        lua_val = val if val in ("true", "false") or val.lstrip("-").isdigit() else f'"{val}"'
        expr = lua_val
        for p in reversed(parts):
            expr = "{ " + p + " = " + expr + " }"
        run_cmd(f"hyprctl eval 'hl.config({expr})'")
        self.notify(f"Applied {key} = {val}")

    def on_save_git_identity(self, _btn):
        name = self.git_name_entry.get_text().strip()
        email = self.git_email_entry.get_text().strip()
        if name:
            subprocess.run(["git", "config", "--global", "user.name", name], check=False)
        if email:
            subprocess.run(["git", "config", "--global", "user.email", email], check=False)
        self.notify("Saved Git identity to ~/.gitconfig!")

    def on_apply_display(self, _btn):
        res_idx = max(0, self.res_combo.get_active())
        fps_idx = max(0, self.fps_combo.get_active())
        scale_idx = max(0, self.scale_combo.get_active())

        res = RESOLUTIONS[res_idx][1]
        fps = REFRESH_RATES[fps_idx][1]
        scale = SCALES[scale_idx][1]

        self.apply_display_values(res, fps, scale)

    def apply_display_values(self, res, fps, scale):
        self.monitors = get_monitors()
        mon_name = self.monitors[0].get("name", "Virtual-1") if self.monitors else "Virtual-1"

        if res == "preferred":
            mode_str = "preferred"
            hypr_rule = f"monitor = ,preferred,auto,{scale}"
            wlr_cmd = f"wlr-randr --output {mon_name} --preferred --scale {scale}"
        else:
            mode_str = f"{res}@{fps}"
            hypr_rule = f"monitor = ,{mode_str},auto,{scale}"
            wlr_cmd = f"wlr-randr --output {mon_name} --mode {res}@{fps}Hz --scale {scale}"

        # 1. Apply live in Hyprland
        run_cmd(f'hyprctl keyword monitor ",{mode_str},auto,{scale}"')
        run_cmd(f'hyprctl keyword monitor "{mon_name},{mode_str},auto,{scale}"')
        run_cmd(wlr_cmd)

        # 2. Persist permanently to ~/.config/hypr/monitors.conf
        mon_conf_path = os.path.expanduser("~/.config/hypr/monitors.conf")
        os.makedirs(os.path.dirname(mon_conf_path), exist_ok=True)
        content = (
            "# ==============================================================================\n"
            "# KryptonOS Persistent Display & Resolution Configuration\n"
            "# Automatically saved by Krypton Display Settings\n"
            "# ==============================================================================\n"
            f"{hypr_rule}\n"
        )
        try:
            with open(mon_conf_path, "w", encoding="utf-8") as f:
                f.write(content)
            subprocess.run(["sync"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            sys.stderr.write(f"Failed to save monitors.conf: {e}\n")

        self.notify(f"Applied and saved {mode_str} (Scale {scale}x) permanently!")


def main():
    try:
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)
        provider = Gtk.CssProvider()
        provider.load_from_data(CATPPUCCIN_CSS)
        screen = Gdk.Screen.get_default()
        if screen:
            Gtk.StyleContext.add_provider_for_screen(
                screen,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )
        win = KryptonSettingsWindow()
        win.connect("destroy", Gtk.main_quit)
        win.show_all()
        Gtk.main()
    except Exception as e:
        with open("/tmp/krypton-settings.log", "w") as f:
            traceback.print_exc(file=f)
        subprocess.run(["notify-send", "KryptonOS Settings Error", str(e)])


if __name__ == "__main__":
    main()
