#!/usr/bin/env python3
"""
KryptonOS Windows Executable (.exe / .msi) Compatibility Runner
Executes Windows applications seamlessly using Wine with Catppuccin styling,
HiDPI awareness, Fsync/Esync performance tuning, and automated dependency setup.
"""

import os
import sys
import shutil
import subprocess
from pathlib import Path

def notify(summary, body="", icon="wine", urgency="normal"):
    try:
        subprocess.run(["notify-send", "-a", "Krypton Windows Runner", "-i", icon, "-u", urgency, summary, body], timeout=2)
    except Exception:
        pass

def show_install_dialog(exe_path):
    """Show modern GTK dialog prompting user to install Wine if not found."""
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk, Gdk

        dialog = Gtk.Dialog(
            title="KryptonOS - Windows App Support",
            flags=0
        )
        dialog.set_default_size(440, 240)
        dialog.set_position(Gtk.WindowPosition.CENTER)

        content = dialog.get_content_area()
        content.set_spacing(16)
        content.set_margin_start(24)
        content.set_margin_end(24)
        content.set_margin_top(20)
        content.set_margin_bottom(20)

        title_lbl = Gtk.Label()
        title_lbl.set_markup("<span size='x-large' weight='bold' color='#cba6f7'>Windows Application Detected</span>")
        title_lbl.set_xalign(0)
        content.pack_start(title_lbl, False, False, 0)

        filename = Path(exe_path).name if exe_path else "Windows application"
        desc_lbl = Gtk.Label()
        desc_lbl.set_markup(
            f"You are attempting to launch <b>{filename}</b>.\n\n"
            "To run Windows executables (.exe, .msi) natively, KryptonOS "
            "uses the <b>Wine WoW64</b> compatibility layer.\n\n"
            "Would you like to install Wine support now?"
        )
        desc_lbl.set_line_wrap(True)
        desc_lbl.set_xalign(0)
        content.pack_start(desc_lbl, True, True, 0)

        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        install_btn = dialog.add_button("Install Wine Support", Gtk.ResponseType.OK)
        install_btn.get_style_context().add_class("suggested-action")

        # Apply dark styling
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(b"""
            dialog, window {
                background-color: #1e1e2e;
                color: #cdd6f4;
            }
            button.suggested-action {
                background: #cba6f7;
                color: #11111b;
                font-weight: bold;
                border-radius: 8px;
                padding: 8px 16px;
            }
            button.suggested-action:hover {
                background: #b4befe;
            }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        dialog.show_all()
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK
    except Exception as e:
        print(f":: GTK dialog failed ({e}), falling back to CLI prompt.")
        ans = input(f"Install Wine support to run {exe_path}? [Y/n]: ").strip().lower()
        return ans in ("", "y", "yes")

def install_wine_and_run(exe_path=None):
    """Installs Wine package and then runs the target executable."""
    notify("Installing Wine Support", "Configuring Windows compatibility subsystem...", icon="software-properties")
    # Check if local cache has packages
    pkg_cache = Path("/var/cache/pacman/pkg")
    wine_pkgs = list(pkg_cache.glob("wine*.pkg.tar.zst"))
    if wine_pkgs:
        cmd = "sudo pacman -U --noconfirm /var/cache/pacman/pkg/wine*.pkg.tar.zst"
    else:
        cmd = "sudo pacman -Sy --noconfirm wine winetricks"
    
    if exe_path:
        cmd += f" && krypton-exe-runner '{exe_path}'"
    subprocess.Popen(["kitty", "--title", "KryptonOS - Installing Wine Support", "bash", "-c", f"{cmd}; echo 'Installation complete. Press enter to exit'; read"])

def run_exe(exe_path, args=None):
    """Launch the Windows executable with optimized Wine environment."""
    if not os.path.exists(exe_path):
        notify("File Not Found", f"Cannot find '{exe_path}'", urgency="critical")
        print(f"Error: Target file '{exe_path}' does not exist.")
        sys.exit(1)

    wine_bin = shutil.which("wine") or "/usr/bin/wine"
    if not os.path.exists(wine_bin):
        # Look for wine64 or wine in other locations
        if os.path.exists("/usr/bin/wine64"):
            wine_bin = "/usr/bin/wine64"
        else:
            if show_install_dialog(exe_path):
                install_wine_and_run(exe_path)
            return

    exe_file = Path(exe_path).resolve()
    workdir = str(exe_file.parent)
    name = exe_file.name

    # Check if wineprefix exists, if not notify user that it's initializing
    wineprefix = Path(os.environ.get("WINEPREFIX", Path.home() / ".wine"))
    if not wineprefix.exists():
        notify("First-Time Windows Setup", "Configuring Windows prefix for first launch...", icon="wine")

    notify("Launching Windows Application", f"Starting {name} via Wine...", icon="wine")

    # High performance and clean environment
    env = os.environ.copy()
    env["WINEFSYNC"] = "1"
    env["WINEESYNC"] = "1"
    env["WINEDEBUG"] = "-all"
    env["DXVK_ASYNC"] = "1"
    env["WINEARCH"] = "win64"

    # Determine command based on extension
    suffix = exe_file.suffix.lower()
    if suffix == ".msi":
        msi_bin = shutil.which("msiexec") or "msiexec"
        cmd = [msi_bin, "/i", str(exe_file)]
    elif suffix in (".bat", ".cmd"):
        cmd = [wine_bin, "cmd", "/c", str(exe_file)]
    else:
        cmd = [wine_bin, str(exe_file)]

    if args:
        cmd.extend(args)

    try:
        subprocess.Popen(
            cmd,
            cwd=workdir,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
    except Exception as e:
        notify("Launch Failed", f"Failed to execute {name}: {e}", urgency="critical")
        print(f"Error launching Windows executable: {e}")

def main():
    if len(sys.argv) < 2:
        print("Usage: krypton-exe-runner <path-to-exe-or-msi>")
        print("Commands:")
        print("  config   - Open Wine Configuration (winecfg)")
        print("  kill     - Terminate all running Wine Windows programs")
        print("  tricks   - Launch Winetricks helper")
        print("  explorer - Open Wine File Explorer")
        print("  regedit  - Open Wine Registry Editor")
        print("  install  - Install Wine support package")
        sys.exit(0)

    arg = sys.argv[1]

    if arg in ("config", "--config", "winecfg"):
        notify("Wine Configuration", "Opening Wine Settings...", icon="wine")
        subprocess.Popen(["winecfg"])
    elif arg in ("kill", "--kill", "stop"):
        subprocess.run(["wineserver", "-k"])
        notify("Wine Shutdown", "All Wine Windows programs and background servers terminated.", icon="process-stop")
    elif arg in ("tricks", "--tricks", "winetricks"):
        subprocess.Popen(["winetricks"])
    elif arg in ("explorer", "--explorer"):
        subprocess.Popen(["wine", "winefile"])
    elif arg in ("regedit", "--regedit"):
        subprocess.Popen(["wine", "regedit"])
    elif arg in ("install", "--install"):
        install_wine_and_run()
    else:
        run_exe(arg, sys.argv[2:])

if __name__ == "__main__":
    main()
