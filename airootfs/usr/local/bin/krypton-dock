#!/usr/bin/env python3
"""
KryptonOS Native Dock / Taskbar (GTK 3.0 + GtkLayerShell)
Requirements:
1. Start button: Official Krypton Crystal Shield icon only, no text.
2. Authentic App Icons ONLY: Kitty, Helium, Thunar, VS Code, Settings.
3. Hyprland Workspace Integration:
   - Left click: Focuses the window (switches workspace automatically if needed) or launches it.
   - Right click: Closes/Exits the window (`✕ Exit`), launches new instance, or manages pins.
4. Clean, responsive, crash-proof.
"""
import glob
import json
import os
import signal
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, GtkLayerShell

def ensure_hypr_env():
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        uid = getattr(os, "getuid", lambda: 1000)()
        candidates = [
            os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}"),
            f"/run/user/{uid}",
            "/run/user/1000",
        ]
        for rt in candidates:
            if not rt or not os.path.exists(rt):
                continue
            matches = glob.glob(f"{rt}/hypr/*/.socket.sock") + glob.glob("/tmp/hypr/*/.socket.sock")
            if matches:
                matches.sort(key=os.path.getmtime, reverse=True)
                sig = os.path.basename(os.path.dirname(matches[0]))
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig
                os.environ["XDG_RUNTIME_DIR"] = rt
                break

PINS_FILE = os.path.expanduser("~/.config/krypton/dock_pins.json")

