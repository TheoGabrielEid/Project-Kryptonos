#!/usr/bin/env python3
"""
KryptonOS Display & Resolution Persistence Daemon
Automatically monitors display output, tracks resolution changes (e.g. VMware window resizing or GUI changes),
and saves the active resolution to ~/.config/hypr/monitors.conf so it persists permanently across reboots.
"""
import json
import os
import subprocess
import sys
import time

MONITORS_CONF = os.path.expanduser("~/.config/hypr/monitors.conf")
LAST_STATE_FILE = os.path.expanduser("~/.config/hypr/.last_resolution")


def get_current_monitor():
    try:
        out = subprocess.check_output(
            ["hyprctl", "monitors", "-j"],
            stderr=subprocess.DEVNULL,
            timeout=2.0,
            text=True
        )
        monitors = json.loads(out)
        if isinstance(monitors, list) and len(monitors) > 0:
            # Prefer focused or first monitor
            for m in monitors:
                if m.get("focused", False):
                    return m
            return monitors[0]
    except Exception:
        pass
    return None


def apply_saved_config():
    """On startup, ensure the saved resolution in monitors.conf is applied to Hyprland."""
    if os.path.exists(MONITORS_CONF):
        try:
            with open(MONITORS_CONF, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("monitor") and "=" in line:
                        rule = line.split("=", 1)[1].strip()
                        subprocess.run(
                            ["hyprctl", "keyword", "monitor", rule],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL
                        )
                        break
        except Exception:
            pass


def save_monitor_config(width, height, refresh_rate, scale):
    os.makedirs(os.path.dirname(MONITORS_CONF), exist_ok=True)
    fps = int(round(refresh_rate))
    scale_str = f"{scale:g}" if isinstance(scale, (int, float)) else str(scale)
    
    rule = f"monitor = ,{width}x{height}@{fps},auto,{scale_str}\n"
    content = (
        "# ==============================================================================\n"
        "# KryptonOS Persistent Display & Resolution Configuration\n"
        "# Automatically saved and restored across reboots\n"
        "# ==============================================================================\n"
        f"{rule}"
    )
    try:
        with open(MONITORS_CONF, "w", encoding="utf-8") as f:
            f.write(content)
        with open(LAST_STATE_FILE, "w", encoding="utf-8") as f:
            f.write(f"{width}x{height}@{fps}@{scale_str}")
        subprocess.run(["sync"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def main():
    # Wait for Hyprland IPC to become available
    time.sleep(2)
    apply_saved_config()

    last_sig = ""
    if os.path.exists(LAST_STATE_FILE):
        try:
            with open(LAST_STATE_FILE, "r") as f:
                last_sig = f.read().strip()
        except Exception:
            pass

    while True:
        try:
            mon = get_current_monitor()
            if mon:
                w = mon.get("width", 0)
                h = mon.get("height", 0)
                rr = mon.get("refreshRate", 60.0)
                scale = mon.get("scale", 1.0)
                
                if w > 0 and h > 0:
                    fps = int(round(rr))
                    scale_str = f"{scale:g}" if isinstance(scale, (int, float)) else str(scale)
                    current_sig = f"{w}x{h}@{fps}@{scale_str}"
                    
                    if current_sig != last_sig:
                        save_monitor_config(w, h, rr, scale)
                        last_sig = current_sig
        except Exception:
            pass
        time.sleep(3)


if __name__ == "__main__":
    main()
