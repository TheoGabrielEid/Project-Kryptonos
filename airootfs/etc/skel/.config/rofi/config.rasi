configuration {
    modi: "drun,run,window";
    lines: 7;
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: "   Window";
}

@theme "/dev/null"

* {
    bg-col:  #1e1e2e;
    bg-col-light: #313244;
    border-col: #cba6f7;
    selected-col: #cba6f7;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-col2: #11111b;
    grey: #6c7086;
    width: 600;
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 380px;
    border: 2px;
    border-color: @border-col;
    border-radius: 14px;
    background-color: @bg-col;
    padding: 16px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 8px;
    padding: 4px;
}

prompt {
    background-color: @blue;
    padding: 8px 12px;
    text-color: @fg-col2;
    border-radius: 8px;
    margin: 0px 0px 0px 0px;
}

entry {
    padding: 8px;
    margin: 0px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    border-radius: 8px;
}

listview {
    border: 0px 0px 0px;
    padding: 8px 0px 0px;
    margin: 10px 0px 0px 0px;
    columns: 1;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
}

element selected {
    background-color:  @selected-col;
    text-color: @fg-col2;
}
