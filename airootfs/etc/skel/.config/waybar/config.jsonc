{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-left": 14,
    "margin-right": 14,
    "height": 38,
    "spacing": 8,
    "modules-left": [
        "custom/launcher",
        "custom/files",
        "custom/browser",
        "custom/terminal",
        "hyprland/workspaces",
        "hyprland/window",
        "custom/win-min",
        "custom/win-max",
        "custom/win-close"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "battery",
        "tray",
        "custom/settings",
        "custom/power"
    ],
    "custom/launcher": {
        "format": " ⬢  KRYPTON ",
        "on-click": "rofi -show drun",
        "tooltip-format": "KryptonOS App Launcher (Super+Space)"
    },
    "custom/files": {
        "format": "   Files ",
        "on-click": "thunar",
        "on-click-right": "kitty -e yazi",
        "tooltip-format": "File Explorer — Left click: Thunar GUI | Right click: Yazi Terminal File Manager (Super+E)"
    },
    "custom/browser": {
        "format": " 󰈹  Helium ",
        "on-click": "helium-browser",
        "tooltip-format": "Helium Browser (Super+B)"
    },
    "custom/terminal": {
        "format": "  ",
        "on-click": "kitty",
        "tooltip-format": "Kitty Terminal (Super+Return)"
    },
    "custom/win-min": {
        "format": " 󰖰 ",
        "on-click": "/usr/local/bin/krypton-win-ctl minimize",
        "on-click-right": "/usr/local/bin/krypton-win-ctl restore",
        "tooltip-format": "Minimize Active App (Left-click) | Restore Minimized App (Right-click or Super+M)"
    },
    "custom/win-max": {
        "format": " 󰊓 ",
        "on-click": "/usr/local/bin/krypton-win-ctl fullscreen",
        "on-click-right": "/usr/local/bin/krypton-win-ctl maximize",
        "tooltip-format": "Full Screen Active App (Left-click or Super+F) | Maximize Tiled (Right-click)"
    },
    "custom/win-close": {
        "format": " 󰅖 ",
        "on-click": "/usr/local/bin/krypton-win-ctl close",
        "tooltip-format": "Exit / Close Active App (Super+Q)"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "urgent": "",
            "active": "",
            "default": ""
        }
    },
    "clock": {
        "format": "  {:%H:%M  󰃭 %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " {}%"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰖪 Offline"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "custom/settings": {
        "format": " ",
        "on-click": "/usr/local/bin/krypton-settings",
        "tooltip-format": "KryptonOS System Settings (Display, FPS, Audio)"
    },
    "custom/power": {
        "format": " ",
        "on-click": "/usr/local/bin/krypton-powermenu",
        "tooltip": false
    }
}
