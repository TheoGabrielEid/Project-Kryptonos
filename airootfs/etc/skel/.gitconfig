# ==============================================================================
# KryptonOS Global Git Configuration - Developer Optimized
# ==============================================================================

[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = less -FRX
    autocrlf = input
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[color]
    ui = auto

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = simple

[rebase]
    autoStash = true

[diff]
    colorMoved = default
    algorithm = histogram

[merge]
    conflictstyle = diff3

[alias]
    st = status -sb
    co = checkout
    cb = checkout -b
    br = branch -v
    ci = commit -v
    cm = commit -m
    ca = commit -a -m
    df = diff
    dfs = diff --staged
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    undo = reset --soft HEAD~1
    unstage = reset HEAD --
    last = log -1 HEAD --stat
    branches = branch -a
    remotes = remote -v
